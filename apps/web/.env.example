# Turso Database Configuration
# Get these values from: https://turso.tech
# 1. Create account: turso auth signup
# 2. Create database: turso db create gymmer
# 3. Get URL: turso db show gymmer --url
# 4. Get token: turso db tokens create gymmer

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# For local development you can skip Turso and use a SQLite file instead
# (see README.md, "Create a local database"). The auth token is ignored for file: URLs.
# TURSO_DATABASE_URL=file:./.local/dev.db

# NextAuth / OAuth
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# The OAuth client must allow http://localhost:3000/api/auth/callback/google for local dev.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Comma-separated Google emails allowed to sign in (case-sensitive).
ALLOWED_EMAILS=

# Claude / Anthropic LLM calls
# Create a key in Anthropic Console and add it in Vercel project env vars.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_VERSION=2023-06-01

# App token exchange (mobile)
APP_JWT_SECRET=change-me-to-a-long-random-string

# Nightly cardio activity reminders (Web Push)
# Generate VAPID keys with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Also supported for compatibility:
# WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
# WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
# WEB_PUSH_SUBJECT=mailto:you@example.com

# Used by the scheduled reminder endpoint.
CRON_SECRET=change-me-to-a-long-random-string
CRON_JOB_ORG_API_KEY=your-cron-job-org-api-key

# Bug report emails from /report-bug (optional)
# RESEND_API_KEY=your-resend-api-key
# BUG_REPORT_FROM_EMAIL=bugs@example.com
# BUG_REPORT_TO_EMAIL=you@example.com
